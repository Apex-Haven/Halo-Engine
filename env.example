# HALO Backend Environment Variables
# Copy this file to .env and fill in your values

# Server Configuration
NODE_ENV=production
PORT=707

# Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/halo?retryWrites=true&w=majority

# JWT Secret (generate a strong secret)
JWT_SECRET=your-super-secret-jwt-key-here

# Email Configuration (Optional - for email notifications)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# CORS Configuration
ALLOWED_ORIGINS=https://your-frontend-domain.netlify.app,http://localhost:7070

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Flight Tracking API
AVIATIONSTACK_API_KEY=your-aviationstack-api-key-here

# RapidAPI (Hotel Search - Agoda)
# Get your API key from https://rapidapi.com/
# Subscribe to Agoda Com API: https://rapidapi.com/apidojo/api/agoda-com
RAPIDAPI_KEY=fdf79338acmshb8b3f243c0063c1p1dee3fjsn307375807fc1
RAPIDAPI_HOTEL_HOST=agoda-com.p.rapidapi.com
RAPIDAPI_HOTEL_URL=https://agoda-com.p.rapidapi.com

# Optional: Free ML/AI Services
OLLAMA_BASE_URL=http://localhost:11434
USE_ML_MATCHING=false

# Security Configuration
JWT_REFRESH_SECRET=<different-strong-secret-from-jwt-secret>
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW=300000
# Set DISABLE_AUTH_RATE_LIMIT=true to disable authentication rate limiting
# Or set AUTH_RATE_LIMIT_MAX=0 to disable (alternative method)
DISABLE_AUTH_RATE_LIMIT=false

# Security Features
ENABLE_BRUTE_FORCE_PROTECTION=false
ENABLE_CSRF=false
ENABLE_IP_WHITELIST=false
TRUSTED_IPS=127.0.0.1,::1
# Set DISABLE_ACCOUNT_LOCK=true to disable account locking after failed login attempts
DISABLE_ACCOUNT_LOCK=false

# Logging
LOG_LEVEL=info
LOG_SECURITY_EVENTS=true
AUDIT_ALL_REQUESTS=false
LOG_FILE_PATH=./logs

# Puppeteer Configuration (for Render.com)
# Set this if Chrome is installed system-wide
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
# Optional: Set cache directory for Puppeteer
# PUPPETEER_CACHE_DIR=/opt/render/.cache/puppeteer
# Set to true to disable Puppeteer features
# DISABLE_PUPPETEER=false